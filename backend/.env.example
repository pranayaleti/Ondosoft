# Required in production
DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET=replace-with-a-long-random-string

# Optional CSRF cookie SameSite (lax | strict | none). Default: lax
# CSRF_SAMESITE=lax

# Captcha — optional. If a secret is set, Contact / Feedback / Newsletter fail closed without a valid token.
# Prefer Cloudflare Turnstile. reCAPTCHA v3 is the fallback if Turnstile is unset.
# TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_SITE_KEY=

# RECAPTCHA_SECRET_KEY=
# VITE_RECAPTCHA_SITE_KEY=

# Frontend captcha keys belong in the Vite env (repo root), not only here:
# VITE_TURNSTILE_SITE_KEY=...
# VITE_RECAPTCHA_SITE_KEY=...

# Sitemap + prerender also read DATABASE_URL here to include published CMS posts.
# Without it, those scripts keep static blogData.js posts and log a warning.
